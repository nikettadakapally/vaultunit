{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "VaultUnit: start backend",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\backend-new\\start-backend.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\backend-new"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vaultunit-backend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^(VaultUnit API is already responding on port [0-9]+; skipping duplicate startup\\.|.*Started .* in .* seconds.*)$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "clear": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "VaultUnit: start frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vaultunit-frontend",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "^.*Local:\\s+http://127\\.0\\.0\\.1:5173/.*$"
        }
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    },
    {
      "label": "VaultUnit: start on folder open",
      "dependsOn": [
        "VaultUnit: start backend",
        "VaultUnit: start frontend"
      ],
      "dependsOrder": "parallel",
      "runOptions": {
        "runOn": "folderOpen"
      }
    },
    {
      "label": "VaultUnit: build frontend",
      "type": "shell",
      "command": "npm.cmd",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
